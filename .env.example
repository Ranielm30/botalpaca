# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (allowlist).
TELEGRAM_ALLOWED_USER_IDS=

# ---- Trading environment ----
# Active environment at startup: PAPER | REAL
ACTIVE_TRADING_ENVIRONMENT=PAPER

# ---- Alpaca PAPER (paper-api.alpaca.markets) ----
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER_DATA_URL=https://data.alpaca.markets

# ---- Alpaca LIVE (api.alpaca.markets) ----
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_LIVE_DATA_URL=https://data.alpaca.markets

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./data/botalpaca.db
# Run Alembic migrations at startup (set to false to manage schema manually)
DATABASE_MIGRATE=true
# Also create missing tables directly (convenient for local dev / tests)
DATABASE_AUTO_CREATE=true

# ---- Runtime ----
TIMEZONE=America/New_York
LOG_LEVEL=INFO
LOG_JSON=true
SCAN_INTERVAL_SECONDS=60
MONITOR_INTERVAL_SECONDS=60
RECONCILE_INTERVAL_SECONDS=300
